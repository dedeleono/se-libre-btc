generator client {
  provider = "prisma-client-js"

  previewFeatures = ["postgresqlExtensions"]
  engineType      = "binary"
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String   @id @default(cuid())
  name                String?
  role                UserRole @default(STUDENT)
  email               String   @unique
  emailVerified       DateTime?
  firstName           String?
  lastName            String?
  phone               String?
  image               String?
  onboardingCompleted Boolean  @default(false)
  isDeleted           Boolean  @default(false)
  isBanned            Boolean  @default(false)

  accounts Account[]
  sessions Session[]

  payments                Payment[]
  uploadedAttachments     Attachment[]
  courseEnrollments       CourseEnrollment[]
  learningPathEnrollments LearningPathEnrollment[]
  cohortEnrollments       CohortEnrollment[]
  quizAttempts            QuizAttempt[]
  courseContributions     CourseContributor[]
  chapterProgress         ChapterProgress[]

  forumPosts         ForumPost[]
  forumReplies       ForumReply[]
  forumViews         ForumView[]
  notes              StudentNote[]
  chapterDiscussions ChapterDiscussion[]

  sentNotifications     Notification[] @relation("SentNotifications")
  receivedNotifications Notification[] @relation("ReceivedNotifications")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
}

model PendingInvitation {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  firstName String
  lastName  String
  role      UserRole @default(STUDENT)
  phone     String?
  token     String   @unique
  expires   DateTime
  metadata  Json?

  paymentId      String? @unique
  payment        Payment? @relation(fields: [paymentId], references: [id])
  courseId       String?
  course         Course? @relation(fields: [courseId], references: [id])
  learningPathId String?
  learningPath   LearningPath? @relation(fields: [learningPathId], references: [id])
  cohortId       String?
  cohort         Cohort? @relation(fields: [cohortId], references: [id])

  createdAt DateTime @default(now())

  @@index([courseId])
  @@index([learningPathId])
  @@index([cohortId])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Course {
  id                String             @id @default(uuid())
  title             String             @db.Text
  slug              String             @unique
  shortDescription  String?            @db.Text
  description       String?            @db.Text
  imageUrl          String?            @db.Text
  difficulty        CourseDifficulty   @default(BEGINNER)
  deliveryMode      CourseDeliveryMode @default(SELF_PACED)
  estimatedDuration String?
  lessonDuration    String?
  isFree            Boolean            @default(true)
  price             Decimal?           @db.Decimal(10, 2)
  isPublished       Boolean            @default(false)
  publishedAt       DateTime?

  courseCategory     CourseCategory[]
  modules            CourseModule[]
  attachments        Attachment[]
  payments           Payment[]
  contributors       CourseContributor[]
  enrollments        CourseEnrollment[]
  learningPaths      LearningPathCourse[]
  cohorts            Cohort[]
  liveSessions       LiveSession[]
  forumPosts         ForumPost[]
  studentNotes       StudentNote[]
  notifications      Notification[]
  pendingInvitations PendingInvitation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished])
  @@index([difficulty])
  @@index([deliveryMode])
}

model CourseContributor {
  id       String                @id @default(uuid())
  userId   String
  courseId String
  role     CourseContributorRole @default(EDITOR)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model CourseEnrollment {
  id             String           @id @default(uuid())
  userId         String
  courseId       String
  status         EnrollmentStatus @default(ACTIVE)
  source         EnrollmentSource @default(FREE)
  isPaid         Boolean          @default(false)
  enrolledAt     DateTime         @default(now())
  completedAt    DateTime?
  lastAccessedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@index([status])
}

model Category {
  id   String @id @default(uuid())
  name String @unique

  courses CourseCategory[]
}

model CourseCategory {
  id         String @id @default(uuid())
  courseId   String
  categoryId String

  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([courseId, categoryId])
  @@index([courseId])
  @@index([categoryId])
}

model CourseModule {
  id          String  @id @default(uuid())
  title       String
  description String? @db.Text
  position    Int
  courseId    String

  course   Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  chapters Chapter[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
}

model Chapter {
  id          String      @id @default(uuid())
  title       String
  slug        String?
  type        ChapterType @default(LESSON)
  isIntro     Boolean     @default(false)
  description String?     @db.Text
  startTime   DateTime?
  endTime     DateTime?
  position    Int
  isPublished Boolean     @default(false)

  imageUrl    String? @db.Text
  videoUrl    String? @db.Text
  pdfUrl      String? @db.Text
  richContent String? @db.Text
  youtubeUrl  String? @db.Text

  moduleId      String
  liveSessionId String? @unique

  module          CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  liveSession     LiveSession? @relation(fields: [liveSessionId], references: [id])
  quiz            Quiz?
  attachments     Attachment[]
  studentProgress ChapterProgress[]
  studentNotes    StudentNote[]
  discussions     ChapterDiscussion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([moduleId])
  @@index([type])
}

model ChapterProgress {
  id          String   @id @default(uuid())
  userId      String
  chapterId   String
  isCompleted Boolean  @default(false)
  completedAt DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, chapterId])
  @@index([userId])
  @@index([chapterId])
}

model LearningPath {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  description String?  @db.Text
  imageUrl    String?  @db.Text
  position    Int      @default(0)
  isPublished Boolean  @default(false)
  isFree      Boolean  @default(true)
  price       Decimal? @db.Decimal(10, 2)
  publishedAt DateTime?

  courses            LearningPathCourse[]
  enrollments        LearningPathEnrollment[]
  cohorts            Cohort[]
  liveSessions       LiveSession[]
  payments           Payment[]
  forumPosts         ForumPost[]
  notifications      Notification[]
  pendingInvitations PendingInvitation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished])
  @@index([position])
}

model LearningPathCourse {
  id             String @id @default(uuid())
  learningPathId String
  courseId       String
  position       Int    @default(0)

  learningPath LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  course       Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([learningPathId, courseId])
  @@index([learningPathId])
  @@index([courseId])
}

model LearningPathEnrollment {
  id             String           @id @default(uuid())
  userId         String
  learningPathId String
  status         EnrollmentStatus @default(ACTIVE)
  source         EnrollmentSource @default(FREE)
  isPaid         Boolean          @default(false)
  enrolledAt     DateTime         @default(now())
  completedAt    DateTime?

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  learningPath LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, learningPathId])
  @@index([userId])
  @@index([learningPathId])
  @@index([status])
}

model Cohort {
  id             String       @id @default(uuid())
  title          String
  slug           String       @unique
  description    String?      @db.Text
  status         CohortStatus @default(DRAFT)
  capacity       Int?
  startDate      DateTime?
  endDate        DateTime?
  courseId       String?
  learningPathId String?

  course             Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)
  learningPath       LearningPath? @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  enrollments        CohortEnrollment[]
  liveSessions       LiveSession[]
  forumPosts         ForumPost[]
  notifications      Notification[]
  pendingInvitations PendingInvitation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
  @@index([learningPathId])
  @@index([status])
}

model CohortEnrollment {
  id          String           @id @default(uuid())
  userId      String
  cohortId    String
  status      EnrollmentStatus @default(ACTIVE)
  source      EnrollmentSource @default(COHORT)
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, cohortId])
  @@index([userId])
  @@index([cohortId])
  @@index([status])
}

model LiveSession {
  id             String            @id @default(uuid())
  title          String
  description    String?           @db.Text
  status         LiveSessionStatus @default(SCHEDULED)
  startsAt       DateTime
  endsAt         DateTime?
  meetingUrl     String?           @db.Text
  recordingUrl   String?           @db.Text
  cohortId       String?
  courseId       String?
  learningPathId String?

  cohort       Cohort?       @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  course       Course?       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  learningPath LearningPath? @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  chapter      Chapter?
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cohortId])
  @@index([courseId])
  @@index([learningPathId])
  @@index([startsAt])
  @@index([status])
}

model Quiz {
  id                 String  @id @default(uuid())
  title              String
  description        String? @db.Text
  passingScore       Int     @default(70)
  allowRetries       Boolean @default(true)
  showCorrectAnswers Boolean @default(true)
  chapterId          String  @unique

  chapter   Chapter        @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QuizQuestion {
  id          String           @id @default(uuid())
  quizId      String
  position    Int
  type        QuizQuestionType
  prompt      String           @db.Text
  explanation String?          @db.Text
  points      Int              @default(1)
  metadata    Json?

  quiz           Quiz                @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options        QuizOption[]
  attemptAnswers QuizAttemptAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quizId])
}

model QuizOption {
  id         String  @id @default(uuid())
  questionId String
  content    String  @db.Text
  isCorrect  Boolean @default(false)
  position   Int

  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([questionId])
}

model QuizAttempt {
  id           String            @id @default(uuid())
  quizId       String
  userId       String
  status       QuizAttemptStatus @default(IN_PROGRESS)
  scorePercent Float?
  passed       Boolean?
  startedAt    DateTime          @default(now())
  completedAt  DateTime?

  quiz          Quiz                @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers       QuizAttemptAnswer[]
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quizId])
  @@index([userId])
  @@index([status])
}

model QuizAttemptAnswer {
  id                String   @id @default(uuid())
  attemptId         String
  questionId        String
  selectedOptionIds String[]
  textAnswer        String?  @db.Text
  isCorrect         Boolean?

  attempt  QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}

model Attachment {
  id         String @id @default(uuid())
  name       String
  url        String @db.Text
  uploaderId String
  courseId   String?
  chapterId  String?

  uploader User    @relation(fields: [uploaderId], references: [id])
  course   Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)
  chapter  Chapter? @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([uploaderId])
  @@index([courseId])
  @@index([chapterId])
}

model Payment {
  id             String             @id @default(uuid())
  amount         Decimal            @db.Decimal(10, 2)
  status         PaymentStatus      @default(PENDING)
  productType    PaymentProductType
  paymentMethod  String?
  paymentDate    DateTime           @default(now())
  metadata       Json?
  userId         String
  courseId       String?
  learningPathId String?

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  course            Course?            @relation(fields: [courseId], references: [id])
  learningPath      LearningPath?      @relation(fields: [learningPathId], references: [id])
  pendingInvitation PendingInvitation?
  notifications     Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([courseId])
  @@index([learningPathId])
  @@index([status])
  @@index([productType])
}

model ForumPost {
  id             String   @id @default(cuid())
  title          String
  content        String   @db.Text
  authorId       String
  courseId       String?
  learningPathId String?
  cohortId       String?
  meetingLink    String?
  meetingDate    DateTime?

  author       User          @relation(fields: [authorId], references: [id])
  course       Course?       @relation(fields: [courseId], references: [id])
  learningPath LearningPath? @relation(fields: [learningPathId], references: [id])
  cohort       Cohort?       @relation(fields: [cohortId], references: [id])
  comments     ForumReply[]
  views        ForumView[]
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
  @@index([courseId])
  @@index([learningPathId])
  @@index([cohortId])
}

model ForumReply {
  id        String   @id @default(cuid())
  content   String   @db.Text
  authorId  String
  postId    String
  parentId  String?

  author  User         @relation(fields: [authorId], references: [id])
  post    ForumPost    @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent  ForumReply?  @relation("ReplyToReply", fields: [parentId], references: [id], onDelete: Cascade)
  replies ForumReply[] @relation("ReplyToReply")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
  @@index([postId])
  @@index([parentId])
}

model ForumView {
  id       String   @id @default(cuid())
  postId   String
  userId   String
  viewedAt DateTime @default(now())

  post ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model StudentNote {
  id        String @id @default(uuid())
  content   String @db.Text
  userId    String
  chapterId String
  courseId  String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, chapterId])
  @@index([userId])
  @@index([chapterId])
  @@index([courseId])
}

model ChapterDiscussion {
  id        String @id @default(cuid())
  content   String @db.Text
  authorId  String
  chapterId String

  author  User    @relation(fields: [authorId], references: [id])
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
  @@index([chapterId])
}

model Notification {
  id     String           @id @default(uuid())
  type   NotificationType
  title  String
  body   String           @db.Text
  isRead Boolean          @default(false)

  senderId   String?
  sender     User?   @relation("SentNotifications", fields: [senderId], references: [id])
  receiverId String
  receiver   User    @relation("ReceivedNotifications", fields: [receiverId], references: [id], onDelete: Cascade)

  paymentId      String?
  payment        Payment? @relation(fields: [paymentId], references: [id])
  forumPostId    String?
  forumPost      ForumPost? @relation(fields: [forumPostId], references: [id])
  courseId       String?
  course         Course? @relation(fields: [courseId], references: [id])
  learningPathId String?
  learningPath   LearningPath? @relation(fields: [learningPathId], references: [id])
  cohortId       String?
  cohort         Cohort? @relation(fields: [cohortId], references: [id])
  liveSessionId  String?
  liveSession    LiveSession? @relation(fields: [liveSessionId], references: [id])
  quizAttemptId  String?
  quizAttempt    QuizAttempt? @relation(fields: [quizAttemptId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([receiverId])
  @@index([type])
  @@index([isRead])
  @@index([courseId])
  @@index([learningPathId])
  @@index([cohortId])
}

enum UserRole {
  ADMIN
  STUDENT
}

enum CourseDeliveryMode {
  SELF_PACED
  COHORT
  HYBRID
}

enum CourseDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  EXPIRED
}

enum EnrollmentSource {
  FREE
  PAYMENT
  ADMIN
  COHORT
  LEARNING_PATH
  INVITATION
}

enum CourseContributorRole {
  OWNER
  EDITOR
  REVIEWER
  INSTRUCTOR
}

enum CohortStatus {
  DRAFT
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum LiveSessionStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentProductType {
  COURSE
  LEARNING_PATH
  SUBSCRIPTION
}

enum QuizQuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  FILL_IN_THE_BLANK
}

enum QuizAttemptStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum FileType {
  PDF
  IMAGE
  VIDEO
}

enum ChapterType {
  LESSON
  QUIZ
  RESOURCE
  LIVE_SESSION
}

enum NotificationType {
  PAYMENT_RECEIVED
  PAYMENT_PENDING
  USER_SIGNUP
  FORUM_POST
  FORUM_REPLY
  COURSE_ENROLLED
  LEARNING_PATH_ENROLLED
  COHORT_ENROLLED
  COURSE_COMPLETED
  QUIZ_COMPLETED
  LIVE_SESSION_REMINDER
  ANNOUNCEMENT
}
