generator client {
  provider = "prisma-client-js"

  previewFeatures = ["postgresqlExtensions"]
  engineType      = "binary"
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String    @id @default(cuid())
  name                String?
  role                UserRole  @default(STUDENT)
  email               String    @unique
  emailVerified       DateTime?
  firstName           String?
  lastName            String?
  phone               String?
  image               String?
  onboardingCompleted Boolean   @default(false)
  isDeleted           Boolean   @default(false)
  isBanned            Boolean   @default(false)
  carnet              String?   @unique
  mineducId           String?   @unique

  accounts Account[]
  sessions Session[]
  payments Payment[]

  levelId          String?
  teacherCourses   Course[]                 @relation("TeacherCourses")
  studentCourses   StudentCourse[]
  teacherLevels    LevelTeacher[]
  studentLevel     Level?                   @relation(fields: [levelId], references: [id])
  assignmentScores StudentAssignmentScore[]
  courseScores     StudentCourseScore[]
  levelScores      StudentLevelScore[]
  moduleScores     StudentModuleScore[]
  academicYears    StudentAcademicYear[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions         Submission[]
  createdAssignments  Assignment[] @relation("CreatedAssignments")
  uploadedAttachments Attachment[]

  assignments Assignment[]

  forumPosts   ForumPost[]
  forumReplies ForumReply[]
  forumViews   ForumView[]

  sentNotifications     Notifications[] @relation("SentNotifications")
  receivedNotifications Notifications[] @relation("ReceivedNotifications")

  gradesGiven    GradeHistory[] @relation("TeacherGradeHistory")
  gradesApproved GradeHistory[] @relation("AdminGradeApproval")

  notes StudentNote[]

  chapterDiscussions ChapterDiscussion[]

  @@index([role])
}

model PendingInvitation {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  firstName String
  lastName  String
  role      UserRole
  phone     String?
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
  metadata  Json? // Store additional information like levelId and payment requirements
  paymentId String?  @unique
  payment   Payment? @relation(fields: [paymentId], references: [id])
  levelId   String?
  level     Level?   @relation(fields: [levelId], references: [id])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Assignment {
  id          String    @id @default(uuid())
  title       String
  description String?   @db.Text
  isQuiz      Boolean   @default(false)
  isOnline    Boolean   @default(true)
  maxPoints   Float? // Add this field for file-based submissions
  timer       Int? // Time in minutes
  deadline    DateTime?

  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id])

  questions   Question[]
  submissions Submission[]

  createdById String
  creator     User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentAssignmentScores StudentAssignmentScore[]

  User User[] @relation("CreatedAssignments")

  @@index([createdAt])
  @@index([chapterId])
  @@index([title])
}

model Question {
  id       String       @id @default(uuid())
  position Int
  content  String       @db.Text
  type     QuestionType
  points   Float // Points for this specific question

  // For multiple choice questions
  options       QuestionOption[]
  correctOption String? // ID of the correct option for multiple choice

  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  // Track student answers
  answers Answer[]

  // Matching-specific config
  matchingConfig MatchingConfig?
  matchingPrompts MatchingPrompt[]
  matchingChoices MatchingChoice[]
  matchingPairs MatchingPair[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QuestionOption {
  id              String   @id @default(uuid())
  content         String
  hasBlank        Boolean  @default(false) // Indicates if this option has fillable blanks
  blankPlaceholder String? // Placeholder text for the blank (e.g., "points")
  correctBlankText String? // Expected answer for the blank (for auto-grading)
  questionId      String
  question        Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Submission {
  id              String           @id @default(uuid())
  studentId       String
  assignmentId    String
  status          SubmissionStatus @default(PENDING)
  score           Float? // Final score
  startedAt       DateTime         @default(now())
  submittedAt     DateTime?
  teacherFeedback String?

  // For file uploads
  fileUrl  String?
  fileType FileType?

  answers     Answer[]
  student     User         @relation(fields: [studentId], references: [id])
  assignment  Assignment   @relation(fields: [assignmentId], references: [id])
  attachments Attachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notifications Notifications[]

  gradeHistory   GradeHistory[]
  lastGradedBy   String? // User ID of teacher who last graded it
  regradePending Boolean        @default(false)
  regradeReason  String? // Reason for requesting regrade

  @@unique([studentId, assignmentId])
  @@index([status, score])
  @@index([assignmentId])
}

model Answer {
  id            String   @id @default(uuid())
  content       String   @db.Text
  isCorrect     Boolean? // For multiple choice or teacher-graded
  score         Float? // Points awarded for this answer
  
  // For fillable multiple choice questions
  selectedOptions String[] // Array of selected option IDs
  blankAnswers   Json? // JSON object storing blank text answers: { optionId: "text" }

  submissionId String
  questionId   String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question     Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  // NEW: student-selected pairs for matching questions
  matchingPairs AnswerMatchingPair[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StudentAssignmentScore {
  id          String   @id @default(uuid())
  score       Float
  maxScore    Float // Store the max possible score when the assignment was taken
  submittedAt DateTime @default(now())

  studentId    String
  assignmentId String
  student      User       @relation(fields: [studentId], references: [id])
  assignment   Assignment @relation(fields: [assignmentId], references: [id])

  @@unique([studentId, assignmentId])
}

model StudentCourseScore {
  id          String @id @default(uuid())
  score       Float  @default(0)
  totalPoints Float  @default(100) // Usually 100, but could be configurable

  studentId String
  courseId  String
  student   User   @relation(fields: [studentId], references: [id])
  course    Course @relation(fields: [courseId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, courseId])
}

model StudentLevelScore {
  id    String @id @default(uuid())
  score Float  @default(0)

  studentId String
  levelId   String
  student   User   @relation(fields: [studentId], references: [id])
  level     Level  @relation(fields: [levelId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, levelId])
}

model Attachment {
  id         String @id @default(uuid())
  name       String
  url        String @db.Text
  uploaderId String // Who uploaded the file
  uploader   User   @relation(fields: [uploaderId], references: [id])

  courseId     String?
  chapterId    String?
  submissionId String? // For student assignment submissions
  course       Course?     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  chapter      Chapter?    @relation(fields: [chapterId], references: [id])
  submission   Submission? @relation(fields: [submissionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([uploaderId])
  @@index([submissionId])
}

model Category {
  id   String @id @unique @default(uuid())
  name String @unique

  courses CourseCategory[]
}

model CourseCategory {
  id String @id @default(uuid())

  courseId   String?
  categoryId String?
  course     Course?   @relation(fields: [courseId], references: [id])
  category   Category? @relation(fields: [categoryId], references: [id])
}

model Level {
  id               String  @id @default(uuid())
  name             String
  position         Int     @default(0)
  price            Float?
  inscriptionPrice Float?
  inscriptionPaid  Boolean @default(false)

  levelCourses         LevelCourse[]
  students             User[]
  teacherLevels        LevelTeacher[]
  studentScores        StudentLevelScore[]
  payments             Payment[]
  pendingInvitations   PendingInvitation[]
  studentAcademicYears StudentAcademicYear[]

  forumPosts ForumPost[]
}

model LevelTeacher {
  id        String @id @default(uuid())
  levelId   String
  teacherId String

  level   Level @relation(fields: [levelId], references: [id])
  teacher User  @relation(fields: [teacherId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([levelId, teacherId])
  @@index([levelId])
  @@index([teacherId])
}

model Course {
  id              String    @id @unique @default(uuid())
  title           String    @db.Text
  description     String?   @db.Text
  imageUrl        String?   @db.Text
  isPublished     Boolean   @default(false)
  isFreelance     Boolean   @default(false)
  courseStartDate DateTime?
  courseEndDate   DateTime?
  lessonDuration  String?

  courseCategory CourseCategory[]
  modules        CourseModule[]
  attachments    Attachment[]
  payments       Payment[]

  teacherId String?
  teacher   User?   @relation(name: "TeacherCourses", fields: [teacherId], references: [id])

  levelCourses   LevelCourse[]
  studentCourses StudentCourse[]
  studentScores  StudentCourseScore[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  forumPosts ForumPost[]

  studentNotes StudentNote[]

  @@index([teacherId])
  @@index([isPublished])
}

model LevelCourse {
  id       String @id @default(uuid())
  levelId  String
  courseId String

  level  Level  @relation(fields: [levelId], references: [id])
  course Course @relation(fields: [courseId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([levelId, courseId])
  @@index([levelId])
  @@index([courseId])
}

model StudentCourse {
  id                String  @id @default(uuid())
  studentId         String
  courseId          String
  isPaid            Boolean @default(false)
  isAssignedByLevel Boolean @default(false)

  student User   @relation(fields: [studentId], references: [id])
  course  Course @relation(fields: [courseId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, courseId], name: "studentId_courseId")
  @@index([studentId])
  @@index([courseId])
}

model CourseModule {
  id          String  @id @default(uuid())
  title       String
  description String? @db.Text
  position    Int

  chapters Chapter[]

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  studentModuleScores StudentModuleScore[]

  @@index([courseId])
}

model Chapter {
  id          String      @id @default(uuid())
  title       String
  type        ChapterType @default(LESSON)
  isIntro     Boolean     @default(false)
  description String?
  startTime   DateTime?
  endTime     DateTime?

  position    Int
  isPublished Boolean @default(false)

  imageUrl    String?
  videoUrl    String?
  pdfUrl      String?
  richContent String?
  youtubeUrl  String?

  attachments     Attachment[]
  assignments     Assignment[]
  studentProgress ChapterProgress[]

  moduleId String
  module   CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentNotes StudentNote[]

  discussions ChapterDiscussion[]

  @@index([moduleId])
}

model ChapterProgress {
  id     String @id @default(uuid())
  userId String

  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  isCompleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, chapterId])
  @@index([chapterId])
}

model Payment {
  id             String        @id @default(uuid())
  amount         Float
  status         PaymentStatus @default(PENDING)
  paymentMethod  String?
  paymentDate    DateTime      @default(now())
  metadata       Json? // For storing payment provider specific data
  paymentType    String? // Type of payment: "INSCRIPTION", "MONTHLY", etc.
  academicYearId String? // Link to the academic year this payment is for
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id])

  // Relations
  userEmail           String
  user                User                 @relation(fields: [userEmail], references: [email])
  levelId             String?
  level               Level?               @relation(fields: [levelId], references: [id])
  courseId            String?
  course              Course?              @relation(fields: [courseId], references: [id])
  pendingInvitation   PendingInvitation?
  studentAcademicYear StudentAcademicYear?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notifications Notifications[]

  @@index([userEmail])
  @@index([academicYearId])
}

model ForumPost {
  id          String    @id @default(cuid())
  title       String
  content     String    @db.Text
  authorId    String
  levelId     String?
  courseId    String?
  meetingLink String? // Changed from meetLink to meetingLink for consistency
  meetingDate DateTime? // Added meetingDate
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  author   User         @relation(fields: [authorId], references: [id])
  level    Level?       @relation(fields: [levelId], references: [id])
  course   Course?      @relation(fields: [courseId], references: [id])
  comments ForumReply[]
  views    ForumView[]

  notifications Notifications[]

  @@index([authorId])
  @@index([levelId])
  @@index([courseId])
}

model ForumReply {
  id        String   @id @default(cuid())
  content   String   @db.Text
  authorId  String
  postId    String
  parentId  String? // Added for nested replies
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author  User         @relation(fields: [authorId], references: [id])
  post    ForumPost    @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent  ForumReply?  @relation("ReplyToReply", fields: [parentId], references: [id], onDelete: Cascade)
  replies ForumReply[] @relation("ReplyToReply")

  @@index([authorId])
  @@index([postId])
  @@index([parentId])
}

model ForumView {
  id       String   @id @default(cuid())
  postId   String
  userId   String
  viewedAt DateTime @default(now())

  post ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model StudentModuleScore {
  id          String @id @default(uuid())
  score       Float  @default(0)
  totalPoints Float  @default(100)

  studentId String
  moduleId  String
  student   User         @relation(fields: [studentId], references: [id])
  module    CourseModule @relation(fields: [moduleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, moduleId])
}

model Notifications {
  id     String           @id @default(uuid())
  type   NotificationType
  title  String
  body   String           @db.Text
  isRead Boolean          @default(false)

  senderId String?
  sender   User?   @relation("SentNotifications", fields: [senderId], references: [id])

  receiverId String
  receiver   User   @relation("ReceivedNotifications", fields: [receiverId], references: [id])

  // Optional relations for different notification types
  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id])

  submissionId String?
  submission   Submission? @relation(fields: [submissionId], references: [id])

  forumPostId String?
  forumPost   ForumPost? @relation(fields: [forumPostId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([receiverId])
  @@index([type])
  @@index([isRead])
}

model GradeHistory {
  id           String     @id @default(uuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  score        Float
  gradedBy     String // User ID of teacher
  teacher      User       @relation("TeacherGradeHistory", fields: [gradedBy], references: [id])
  gradedAt     DateTime   @default(now())
  approved     Boolean    @default(false)
  approvedBy   String? // User ID of admin who approved
  approver     User?      @relation("AdminGradeApproval", fields: [approvedBy], references: [id])
  approvedAt   DateTime?
}

model StudentNote {
  id        String @id @default(uuid())
  content   String @db.Text
  userId    String
  chapterId String
  courseId  String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, chapterId])
  @@index([userId])
  @@index([chapterId])
  @@index([courseId])
}

model ChapterDiscussion {
  id        String   @id @default(cuid())
  content   String   @db.Text
  authorId  String
  chapterId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author  User    @relation(fields: [authorId], references: [id])
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([chapterId])
}

model AcademicYear {
  id        String   @id @default(uuid())
  name      String // e.g., "2023-2024"
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)

  studentAcademicYears StudentAcademicYear[]
  payments             Payment[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
}

model StudentAcademicYear {
  id             String         @id @default(uuid())
  studentId      String
  student        User           @relation(fields: [studentId], references: [id])
  academicYearId String
  academicYear   AcademicYear   @relation(fields: [academicYearId], references: [id])
  levelId        String
  level          Level          @relation(fields: [levelId], references: [id])
  status         AcademicStatus @default(ACTIVE)
  finalGrade     Float?
  isPaid         Boolean        @default(false)
  paymentId      String?        @unique
  payment        Payment?       @relation(fields: [paymentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, academicYearId])
  @@index([studentId])
  @@index([academicYearId])
  @@index([levelId])
}

enum AcademicStatus {
  ACTIVE
  COMPLETED
  FAILED
}

enum UserRole {
  ADMIN
  TEACHER
  STUDENT
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum QuestionType {
  MULTIPLE_CHOICE
  OPEN_ENDED
  OPEN_ENDED_WITH_FILE
  FILL_IN_THE_BLANK
  MATCHING
}

enum SubmissionStatus {
  PENDING
  SUBMITTED
  GRADED
}

enum FileType {
  PDF
  IMAGE
  VIDEO
}

enum ChapterType {
  LESSON
  QUIZ
  ASSIGNMENT
}

enum SubscriptionPeriod {
  MONTHLY
  SEMI_ANNUAL
  ANNUAL
}

enum NotificationType {
  PAYMENT_RECEIVED
  PAYMENT_PENDING
  ASSIGNMENT_SUBMISSION
  ASSIGNMENT_GRADED
  USER_SIGNUP
  FORUM_POST
  FORUM_REPLY
}

enum ScoringPolicy {
  ALL_OR_NOTHING
  PARTIAL_PER_PAIR
  PARTIAL_WITH_PENALTY
}

model MatchingConfig {
  id             String        @id @default(uuid())
  questionId     String        @unique
  question       Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  scoringPolicy  ScoringPolicy @default(PARTIAL_PER_PAIR)
  allowReuse     Boolean       @default(false) // if true, a choice can match multiple prompts
  shuffleChoices Boolean       @default(true)
}

model MatchingPrompt {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  content    String   @db.Text
  position   Int      @default(0)

  // One prompt can have exactly one correct choice in 1:1 mode.
  correctPair MatchingPair?

  @@index([questionId])
}

model MatchingChoice {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  content    String   @db.Text
  position   Int      @default(0)
  
  // Relation to matching pairs
  pairs      MatchingPair[]

  @@index([questionId])
}

model MatchingPair {
  id         String          @id @default(uuid())
  questionId String
  question   Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)

  promptId String @unique    // enforce 1:1 by default
  prompt   MatchingPrompt    @relation(fields: [promptId], references: [id], onDelete: Cascade)

  choiceId String
  choice   MatchingChoice    @relation(fields: [choiceId], references: [id], onDelete: Cascade)

  // Student answers
  answerPairs AnswerMatchingPair[]

  @@index([questionId])
  @@unique([questionId, promptId, choiceId])
}

model AnswerMatchingPair {
  id        String @id @default(uuid())
  answerId  String
  answer    Answer @relation(fields: [answerId], references: [id], onDelete: Cascade)

  promptId  String
  choiceId  String
  
  // Reference to the correct pair (optional)
  matchingPairId String?
  matchingPair   MatchingPair? @relation(fields: [matchingPairId], references: [id])

  // Optional denormalization for audit/debug
  isCorrect Boolean?

  @@index([answerId])
  @@unique([answerId, promptId]) // one chosen choice per prompt in this answer
}
