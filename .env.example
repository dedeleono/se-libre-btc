# Database (Postgres / Supabase). DIRECT_URL is used by Prisma migrations.
DATABASE_URL=
DIRECT_URL=
# "true" logs every Prisma query
PRISMA_DEBUG=

# Auth (better-auth). BETTER_AUTH_SECRET falls back to AUTH_SECRET.
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
AUTH_SECRET=
NEXT_PUBLIC_APP_URL=
# Google sign-in (OAuth client from Google Cloud console)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email (SMTP)
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=
# Recipient of the public contact form
CONTACT_EMAIL=

# Storage (Backblaze B2, S3-compatible). Legacy BACKBLAZE_* / AWS_* names are also accepted, see lib/s3.ts.
B2_BUCKET_NAME=
B2_BUCKET_ID=
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_ENDPOINT=
B2_DOWNLOAD_URL=
# "true" serves files from the public bucket URL; anything else proxies through /api/s3/file
STORAGE_PUBLIC_ACCESS=

# Payments (Recurrente), when enabled
NEXT_PUBLIC_RECURRENTE_API_URL=
RECURRENTE_PUBLIC_KEY=
RECURRENTE_SECRET_KEY=
